{
  "name": "aiaudiojs",
  "version": "0.6.0",
  "description": "Thin Web Audio shell over Howler.js — dispose() idempotency, AbortSignal cancellation, first-class equal-power crossfade(), and ai*js conventions. Howler stays as a peerDependency.",
  "keywords": [
    "audio",
    "web-audio",
    "howler",
    "game-audio",
    "crossfade",
    "ios-unlock",
    "ai-readable",
    "typescript",
    "esm"
  ],
  "author": "yshengliao",
  "license": "MIT",
  "homepage": "https://github.com/islumina/aiaudiojs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/islumina/aiaudiojs.git"
  },
  "bugs": {
    "url": "https://github.com/islumina/aiaudiojs/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "README_ZHTW.md",
    "LICENSE",
    "llms.txt",
    "llms-full.txt"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src test",
    "format": "biome format --write src test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "verify:exports": "node scripts/verify-exports.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "check:size": "node scripts/check-size.mjs",
    "build:llms": "node scripts/build-llms-full.mjs",
    "verify:llms": "node scripts/build-llms-full.mjs --check",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm verify:docs && pnpm coverage && pnpm build && pnpm verify:exports && pnpm verify:llms && pnpm check:size"
  },
  "peerDependencies": {
    "howler": "^2.2.4"
  },
  "peerDependenciesMeta": {
    "howler": {
      "optional": false
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "howler": "^2.2.4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "publishConfig": {
    "access": "public"
  }
}
